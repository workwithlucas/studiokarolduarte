{
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase db reset*)",
      "Bash(supabase test*)",
      "Bash(supabase gen types*)",
      "Bash(docker *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": ["Read(./.env*)", "Edit(./.env*)"],
    "ask": ["Bash(git push *)", "Bash(supabase db push*)", "Bash(supabase link*)"]
  }
}